# honeypot-iocs collector 環境設定の例 (実値は含めない)
# 実運用では VM側の /etc/honeypot-iocs/export.env (root:600, git管理外) に書く。
# 未設定でもexporterは動くが、自IPマスクとdecoy判定は無効になる (安全側)。

# 自ホストのグローバルIP (観測からの完全除外 + 文言内マスク)
HONEYPOT_SELF_IPS=

# 除外network (自組織・管理網など。カンマ区切り CIDR)
# 未設定の場合は loopback / RFC1918 / link-local のみが除外される
HONEYPOT_EXCLUDE_NETS=

# decoy判定keyword設定 (json: {"keywords": [...]})
# honeypotが何を罠としているかを公開repoに置かないため、実値はprivate configへ
HONEYPOT_DECOY_CONFIG=/etc/honeypot-iocs/decoy-patterns.json

# 入力ログ (publish.shからexporterへ渡される)
COWRIE_LOG=
CAPTURES_LOG=
